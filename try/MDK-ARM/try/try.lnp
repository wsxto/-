--cpu Cortex-M3
"try\startup_stm32f103xb.o"
"try\main.o"
"try\gpio.o"
"try\dma.o"
"try\tim.o"
"try\usart.o"
"try\stm32f1xx_it.o"
"try\stm32f1xx_hal_msp.o"
"try\stm32f1xx_hal_gpio_ex.o"
"try\stm32f1xx_hal_tim.o"
"try\stm32f1xx_hal_tim_ex.o"
"try\stm32f1xx_hal.o"
"try\stm32f1xx_hal_rcc.o"
"try\stm32f1xx_hal_rcc_ex.o"
"try\stm32f1xx_hal_gpio.o"
"try\stm32f1xx_hal_dma.o"
"try\stm32f1xx_hal_cortex.o"
"try\stm32f1xx_hal_pwr.o"
"try\stm32f1xx_hal_flash.o"
"try\stm32f1xx_hal_flash_ex.o"
"try\stm32f1xx_hal_exti.o"
"try\stm32f1xx_hal_uart.o"
"try\system_stm32f1xx.o"
--strict --scatter "try\try.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "try.map" -o try\try.axf