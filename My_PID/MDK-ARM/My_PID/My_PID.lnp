--cpu Cortex-M3
"my_pid\startup_stm32f103xb.o"
"my_pid\main.o"
"my_pid\gpio.o"
"my_pid\tim.o"
"my_pid\stm32f1xx_it.o"
"my_pid\stm32f1xx_hal_msp.o"
"my_pid\stm32f1xx_hal_gpio_ex.o"
"my_pid\stm32f1xx_hal_tim.o"
"my_pid\stm32f1xx_hal_tim_ex.o"
"my_pid\stm32f1xx_hal.o"
"my_pid\stm32f1xx_hal_rcc.o"
"my_pid\stm32f1xx_hal_rcc_ex.o"
"my_pid\stm32f1xx_hal_gpio.o"
"my_pid\stm32f1xx_hal_dma.o"
"my_pid\stm32f1xx_hal_cortex.o"
"my_pid\stm32f1xx_hal_pwr.o"
"my_pid\stm32f1xx_hal_flash.o"
"my_pid\stm32f1xx_hal_flash_ex.o"
"my_pid\stm32f1xx_hal_exti.o"
"my_pid\system_stm32f1xx.o"
--strict --scatter "My_PID\My_PID.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "My_PID.map" -o My_PID\My_PID.axf